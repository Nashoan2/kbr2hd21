<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:bottom="3.5dp"
                android:left="2dp"
                android:right="2dp"
                android:top="3.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1D5DB0" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#3A8BE8" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:bottom="3.5dp"
                android:left="2dp"
                android:right="2dp"
                android:top="3.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#123F78" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#1C61B3" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
